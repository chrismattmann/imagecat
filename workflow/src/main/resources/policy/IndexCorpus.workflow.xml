<!--
  The three stages that read the whole corpus, run once over the whole
  corpus.

  One instance of this workflow is created per run, by the chunker firing
  ImageCorpusReady after it has catalogued every chunk. It then sits on
  OcrSettled until the OcrChunk count reaches the ChunkList count, and only
  then does any of this work. Ordered Jaccard, then CLIP, then fg/bg,
  because fg/bg reads the CLIP embeddings.
-->
<cas:workflow xmlns:cas="http://oodt.jpl.nasa.gov/1.0/cas"
              name="IndexCorpus" id="urn:imagecat:IndexCorpusWorkflow">
  <tasks>
    <task id="urn:imagecat:IndexMetadataJaccard"/>
    <task id="urn:imagecat:IndexImageSpace"/>
    <task id="urn:imagecat:IndexImageSpaceFgBg"/>
  </tasks>
</cas:workflow>
