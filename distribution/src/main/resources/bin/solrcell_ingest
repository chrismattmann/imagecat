# Compatibility shim. Solr Cell + Tesseract are gone; this calls the
# HuggingFace OCR PGE (TrOCR by default) against Solr 10.

set -euo pipefail

CHUNK_FILE=${1:?Usage: solrcell_ingest <chunk file>}
SOLR_URL=${SOLR_URL:-http://localhost:8983/solr/imagecat}
OCR_MODEL=${OCR_MODEL:-trocr}
OCR_PY=${PGE_ROOT:-${OODT_HOME:?}/pge}/bin/imagecat-ocr/imagecat-ocr.py

exec python3 "$OCR_PY" -f "$CHUNK_FILE" -s "$SOLR_URL" --model "$OCR_MODEL"
