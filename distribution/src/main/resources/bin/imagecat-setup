# Create $IMAGECAT_HOME/.venv and install requirements.txt (pysolr +
# HuggingFace TrOCR/Donut). Restart oodt afterwards so PGEs inherit PATH.

set -euo pipefail

HERE=$(cd "$(dirname "$0")/.." && pwd)
IMAGECAT_HOME=${IMAGECAT_HOME:-$HERE}
REQ=${IMAGECAT_HOME}/requirements.txt
VENV=${IMAGECAT_HOME}/.venv
PYTHON=${PYTHON:-python3}

if [ ! -f "$REQ" ]; then
  echo "No requirements.txt at $REQ" >&2
  exit 1
fi

"$PYTHON" -m venv "$VENV"
"$VENV/bin/python" -m pip install --upgrade pip
"$VENV/bin/python" -m pip install -r "$REQ"
echo "Installed into $VENV"
echo "Restart ImageCat so PGEs pick up $VENV/bin: bin/oodt stop && bin/oodt start"
