<!--
  The imagecat and oodt-fm cores are declared by their own core.properties;
  Solr walks this directory and adopts what it finds. ImageCat runs a single
  node and does not use SolrCloud.
-->
<solr>

  <str name="sharedLib">${solr.sharedLib:}</str>

  <shardHandlerFactory name="shardHandlerFactory" class="HttpShardHandlerFactory">
    <int name="socketTimeout">${socketTimeout:600000}</int>
    <int name="connTimeout">${connTimeout:60000}</int>
  </shardHandlerFactory>

</solr>
